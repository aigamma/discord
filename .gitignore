# Dependencies and build outputs
node_modules
dist

# Environment files — never commit secrets. The pattern catches the
# canonical .env, .env.local, .env.{anything}.local convention plus
# .env.production / .env.staging / .env.development etc. Only
# .env.example (a template with no values) is tracked.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Local credentials and caches
creds.txt
.claude/
tmp/

# SQLite conversation store + WAL/SHM siblings
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Docker build artifacts
.docker/
