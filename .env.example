# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Create a Discord application at https://discord.com/developers/applications,
# add a Bot to it, and copy these values from the application page. Treat the
# bot token as a secret — anyone with it can act as your bot. Rotate via
# "Reset Token" if it ever leaks.

# Bot token. Application → Bot → "Reset Token".
DISCORD_BOT_TOKEN=

# Application (client) ID. Application → General Information → Application ID.
# Used by scripts/register-commands.js to register the /ask slash command.
DISCORD_CLIENT_ID=

# Optional: guild (server) ID. If set, the slash command registers to that
# guild only — guild-scoped registration propagates instantly, which is the
# right choice during development. Leave blank for global registration, which
# takes up to ~1 hour to propagate but applies to every server the bot joins.
# Right-click your server icon → Copy Server ID (requires Developer Mode on
# in Discord User Settings → Advanced).
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# Used to call Claude Sonnet 4.6 for every bot reply. Get from
# https://console.anthropic.com/settings/keys. Treat as a secret.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Market data backend (optional — Supabase via aigamma.com schema)
# ---------------------------------------------------------------------------
# When both are set, the bot exposes tools to Sonnet that fetch live VIX
# family readings, IV percentile, GEX levels, and the SPX term structure
# from a Supabase project laid out per the aigamma.com schema
# (vix_family_eod, daily_volatility_stats, computed_levels,
# expiration_metrics, ingest_runs). When unset, the bot answers from model
# knowledge alone — useful if you want the same conversational surface
# without the live data layer.
#
# Prefer the anon (publishable) key here — the bot only reads, and the anon
# key plus RLS is the safe way to expose row-level filtered reads from a
# server-side process. Service keys bypass RLS and should never sit in a
# repo or process that doesn't strictly need write access.
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Voyage AI embeddings (optional — for semantic search over chat history)
# ---------------------------------------------------------------------------
# Used to embed every Q&A pair persisted to the local SQLite store so the
# model can call search_chat_history to recall past discussions by meaning,
# not just by keyword. Without this, the bot still keeps short-term context
# (last N turns in each channel) but has no semantic recall of older history.
# Get a key at https://www.voyageai.com/.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ---------------------------------------------------------------------------
# Conversation memory
# ---------------------------------------------------------------------------
# Path to the SQLite file that persists every Q&A across restarts. Defaults
# to ./data/conversation.db relative to the project root. The parent
# directory is created automatically on first launch.
# CONVERSATION_DB_PATH=./data/conversation.db

# Number of recent messages from the same channel to include as short-term
# context on every turn. Default 12. Higher = more context, more tokens.
# SHORT_TERM_CONTEXT_TURNS=12

# How many minutes of channel history count as the same conversation.
# Older messages are not loaded into short-term context (they remain
# searchable via the long-term semantic-memory tool). Default 60.
# SHORT_TERM_CONTEXT_MINUTES=60

# Minimum cosine-similarity threshold for search_chat_history results.
# voyage-3 similarities compress into a tight band — 0.15 admits topical
# neighbors and paraphrases while excluding clear noise. Bump higher for
# stricter recall. Default 0.15.
# SEARCH_MIN_SIMILARITY=0.15

# ---------------------------------------------------------------------------
# Rate limiting and capability guardrails
# ---------------------------------------------------------------------------
# Max bot requests per minute per Discord user, across all channels.
# Default 10 — well above human pace, low enough to bound accident damage.
# RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Per-question max tokens for the model output (final assistant turn).
# Default 4096. Bump for very long-form analysis surfaces.
# ANTHROPIC_MAX_TOKENS=4096

# Enable Anthropic's server-side web_search tool (default true). Set to
# false to disable web access entirely, e.g. if the operator wants the
# bot's outputs to be fully self-contained from the model + local data.
# ENABLE_WEB_SEARCH=true

# Enable Anthropic's server-side web_fetch tool (default true).
# ENABLE_WEB_FETCH=true

# Per-user daily cost cap in USD. Reset at midnight UTC. Computed from the
# turns audit log (SUM of cost_usd for the user since the boundary). Set
# to 0 or leave unset to disable. Reasonable default for a tight community
# is 5–20 USD per user per day; budget against your Opus headroom.
# DAILY_USER_COST_CAP_USD=10

# ---------------------------------------------------------------------------
# HTTP health endpoint (optional)
# ---------------------------------------------------------------------------
# When set, starts an HTTP server on the given port exposing /healthz for
# container orchestration probes (kubernetes liveness, docker compose
# healthcheck, fly.io). Cheap probe: checks SQLite reachability and
# returns 200 unless shutting down or SQLite errors. Off by default; the
# in-Discord /health slash command remains available regardless.
# HEALTH_PORT=8080

# ---------------------------------------------------------------------------
# Backtester DuckDB shards (optional)
# ---------------------------------------------------------------------------
# Directory containing the aigamma-backtester DuckDB shards. When shards are
# present at this path, the bot attaches them read-only at startup and
# registers the query_duckdb tool that lets Sonnet run arbitrary SELECT
# queries against multi-year option chains, index history, stock history,
# and pre-computed daily feature tables. When the directory does not exist
# or contains no shards, the tool is silently omitted from the model's tool
# surface and the bot starts cleanly. Default: C:/aigamma-backtester/data
# BACKTESTER_DATA_DIR=C:/aigamma-backtester/data
